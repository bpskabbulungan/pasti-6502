# Docker/Cloudflare production environment template for pasti.databenuanta.id
# Copy to .env.docker and fill required secrets before deployment.

# Required so docker-compose can load this file as service env_file.
APP_ENV_FILE=.env.docker

# Public URL (used by NextAuth callback and metadata base URL)
NEXTAUTH_URL=https://pasti.databenuanta.id
NEXTAUTH_SECRET=replace-with-strong-random-secret

# Force QR target domain to public hostname behind Cloudflare Tunnel
NEXT_PUBLIC_QR_BASE_URL=https://pasti.databenuanta.id
NEXT_PUBLIC_STATIC_UUID=replace-with-static-uuid-v4

# Database (MySQL container service name: pasti_db)
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=pasti_db
MYSQL_USER=pasti_user
MYSQL_PASSWORD=replace-with-strong-user-password
DATABASE_URL=mysql://pasti_user:replace-with-strong-user-password@pasti_db:3306/pasti_db

# Redis (required in production by app)
REDIS_URL=redis://pasti_redis:6379

# App runtime
APP_TIMEZONE=Asia/Makassar
NEXT_PUBLIC_SKD_LINK=https://skd.bps.go.id/skd/s/6502

# Optional WhatsApp bot integration
NEXT_PUBLIC_WA_API_URL=https://pasti.databenuanta.id/wa-api
WA_ADMIN_KEY=

# Optional reminder integration (Fonnte)
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
SCHEDULE_CRON_SECRET=

# Optional SIGAP integration
SIGAP_BASE_URL=https://sigap.databenuanta.id
SIGAP_LOGIN_PATH=/api/auth/login
SIGAP_CONTACTS_PATH=/api/admin/contacts
SIGAP_TOKEN_RESPONSE_PATH=
SIGAP_USERNAME=
SIGAP_PASSWORD=

# Optional analytics export tuning
ANALYTICS_EXPORT_WORKER_CONCURRENCY=1
ANALYTICS_EXPORT_MAX_ROWS=5000
ANALYTICS_EXPORT_STORAGE_PATH=/app/storage/analytics-exports

# Required only if running `docker compose --profile tunnel ...`
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
