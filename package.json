    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.7",
    "prettier": "^3.4.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
