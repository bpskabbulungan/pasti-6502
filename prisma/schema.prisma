generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PETUGAS
}

enum QueueStatus {
  WAITING
  SERVING
  COMPLETED
  CANCELED
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               String               @id @default(uuid())
  username         String               @unique
  password         String
  name             String
  phone            String?
  role             Role                 @default(PETUGAS)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  queues           Queue[]              @relation("AdminQueue")
  dutyQueues       Queue[]              @relation("DutyStaffQueueUser")
  dutySchedules    DutySchedule[]       @relation("DutyScheduleStaff")
  dutyReminderLogs DutyReminderLog[]    @relation("DutyReminderLogStaff")
  analyticsExports AnalyticsExportJob[]
  notifications    Notification[]
  notificationReads NotificationRead[]
}

model Service {
  id        String        @id @default(uuid())
  name      String
  status    ServiceStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  queues    Queue[]
}

model Visitor {
  id            String         @id @default(uuid())
  name          String
  phone         String
  address       String?
  age           Int?
  gender        Gender?
  lastEducation LastEducation?
  occupation    String?
  institution   String?
  email         String?
  purpose       Purpose?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  queues        Queue[]
}

enum QueueType {
  ONLINE
  OFFLINE
}

enum Gender {
  MALE
  FEMALE
}

enum LastEducation {
  SD
  SMP
  SMA_SMK
  D1
  D2
  D3
  D4_S1
  S2
  S3
  LAINNYA
}

enum Purpose {
  KONSULTASI_STATISTIK
  PERPUSTAKAAN
  REKOMENDASI_STATISTIK
  LAINNYA
}

enum DutyCycleStatus {
  ACTIVE
  COMPLETED
}

enum DayOffType {
  HOLIDAY
  LEAVE
}

enum ReminderChannel {
  FONNTE
}

enum AnalyticsExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AnalyticsExportFormat {
  XLSX
  PDF
}

model Queue {
  id           String      @id @default(uuid())
  queueNumber  Int
  status       QueueStatus @default(WAITING)
  queueType    QueueType   @default(OFFLINE)
  queueDate    DateTime    @default(now())
  visitorId    String
  visitor      Visitor     @relation(fields: [visitorId], references: [id])
  guestId      String?
  guest        Guest?      @relation(fields: [guestId], references: [id])
  serviceId    String
  service      Service     @relation(fields: [serviceId], references: [id])
  adminId      String?
  admin        User?       @relation("AdminQueue", fields: [adminId], references: [id])
  dutyStaffId  String?
  dutyStaff    User?       @relation("DutyStaffQueueUser", fields: [dutyStaffId], references: [id])
  startTime    DateTime?
  endTime      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tempUuid     String?     @unique
  filledSKD    Boolean     @default(false)
  serviceRating Int?
  serviceFeedback String?  @db.Text
  feedbackSubmittedAt DateTime?
  trackingLink String?     @unique

  @@unique([queueDate, queueNumber])
  @@index([visitorId])
  @@index([guestId])
  @@index([serviceId])
  @@index([adminId])
  @@index([dutyStaffId])
  @@index([createdAt])
  @@index([status, createdAt])
}

model QueueCounter {
  id         String   @id @default(uuid())
  queueDate  DateTime @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AnalyticsExportJob {
  id            String                @id @default(uuid())
  requestedById String
  requestedBy   User                  @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  status        AnalyticsExportStatus @default(PENDING)
  format        AnalyticsExportFormat
  startDate     DateTime
  endDate       DateTime
  fileName      String?
  storageKey    String?               @unique
  contentType   String?
  payload       Bytes?                @db.LongBlob
  errorMessage  String?
  expiresAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}

model DutyCycle {
  id           String          @id @default(uuid())
  cycleNumber  Int
  status       DutyCycleStatus @default(ACTIVE)
  staffOrder   Json
  currentIndex Int             @default(0)
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  schedules    DutySchedule[]
}

model DutySchedule {
  id           String            @id @default(uuid())
  scheduleDate DateTime
  staffId      String
  staff        User              @relation("DutyScheduleStaff", fields: [staffId], references: [id])
  cycleId      String
  cycle        DutyCycle         @relation(fields: [cycleId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reminderLogs DutyReminderLog[]

  @@unique([scheduleDate])
  @@index([staffId])
  @@index([cycleId])
}

model DutySettings {
  id                String            @id @default("default")
  workDays          Json
  reminderEnabled   Boolean           @default(true)
  autoAssignEnabled Boolean           @default(true)
  reminderTemplate  String            @db.Text
  timezone          String            @default("Asia/Makassar")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  dayOffs           DutyDayOff[]
  reminderLogs      DutyReminderLog[]
}

model DutyDayOff {
  id         String       @id @default(uuid())
  date       DateTime
  name       String
  type       DayOffType   @default(HOLIDAY)
  note       String?
  settingsId String       @default("default")
  settings   DutySettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([date])
  @@index([date])
}

model DutyReminderLog {
  id               String          @id @default(uuid())
  reminderDate     DateTime
  staffId          String
  staff            User            @relation("DutyReminderLogStaff", fields: [staffId], references: [id])
  scheduleId       String?
  schedule         DutySchedule?   @relation(fields: [scheduleId], references: [id])
  settingsId       String
  settings         DutySettings    @relation(fields: [settingsId], references: [id], onDelete: Restrict)
  phoneNumber      String?
  message          String          @db.Text
  channel          ReminderChannel @default(FONNTE)
  success          Boolean         @default(false)
  providerResponse Json?
  errorMessage     String?
  createdAt        DateTime        @default(now())

  @@unique([reminderDate, staffId, channel])
  @@index([reminderDate])
  @@index([staffId])
  @@index([scheduleId])
}

model QRCode {
  id         String   @id @default(uuid())
  staticUuid String   @unique
  path       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TempVisitorLink {
  id        String   @id @default(uuid())
  uuid      String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  used      Boolean  @default(false)
}

model Notification {
  id        String   @id @default(uuid())
  type      String // NEW_QUEUE, REMINDER_SKD, etc.
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String? // Optional, if notification is targeted to specific user
  user      User?    @relation(fields: [userId], references: [id])
  reads     NotificationRead[]

  @@index([userId])
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([notificationId])
}

model Guest {
  id            String         @id @default(uuid())
  fullName      String
  email         String?
  address       String?
  phone         String
  age           Int?
  institution   String?
  gender        Gender?
  lastEducation LastEducation?
  occupation    String?
  purpose       Purpose?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  queues        Queue[]
}
